---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import PageCounter from '../components/PageCounter.astro';
import Lightbox from '../components/Lightbox.astro';
import BackButton from '../components/BackButton.astro';
import { site } from '../data/site';
import { plain } from '../lib/content';

interface Props {
  title?: string; // page title; the site title is added after it
  description?: string;
  room: number; // which of the five rooms, for the page counter
}

const { title, description = site.description, room } = Astro.props;
const fullTitle = plain(title ? `${title} · ${site.title}` : site.title);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <script is:inline>
      // `js` = scripts run; `motion` = animate (not with reduced motion).
      // If the motion script failed to load, show everything once the page has
      // loaded (slow networks just wait; they don't lose the animations).
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        // Theme before first paint: a saved choice wins, otherwise the system setting.
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') html.dataset.theme = saved;
        } catch (e) {}
        html.dataset.mode = html.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) html.classList.add('motion');
        window.addEventListener('load', function () {
          setTimeout(function () {
            if (!window.__motionReady) html.classList.remove('motion');
          }, 500);
        });
      })();
    </script>
  </head>
  <body class="overflow-x-clip">
    <Nav />
    <slot name="hero" />
    <main id="main" class="mx-auto max-w-7xl px-4 pb-32 sm:px-8">
      <slot />
    </main>
    <slot name="after" />
    <BackButton />
    <PageCounter room={room} />
    <Lightbox />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
