---
import Layout from '../../layouts/Layout.astro';
import PrevNext from '../../components/PrevNext.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { formatDate, getAppendices, getPart2, pad } from '../../lib/content';

export async function getStaticPaths() {
  const appendices = await getAppendices();
  const works = await getPart2();
  return appendices.map((appendix, i) => ({
    params: { n: String(appendix.data.number) },
    props: {
      appendix,
      prev: appendices[i - 1],
      next: appendices[i + 1],
      work: works.find((w) => w.data.number === appendix.data.number),
    },
  }));
}

const { appendix, prev, next, work } = Astro.props;
const { data } = appendix;
const items = [...data.items].sort((a, b) => a.date.getTime() - b.date.getTime());
const link = (a?: typeof appendix) =>
  a && { href: `/appendices/${a.data.number}`, label: `${pad(a.data.number)} / ${a.data.folder}` };
---

<Layout title={`Appendix ${data.number}: ${data.title}`} room={5}>
  <header class="pt-28 pb-8">
    {work && <a href={`/part-2/${work.id}`} class="label block w-fit underline-offset-4 transition-colors hover:text-accent hover:underline">← Back to the work</a>}
    <h1 class="mt-8 inline-block border border-b-0 border-rule px-5 pt-3 pb-2 font-mono text-lg sm:text-2xl">
      {pad(data.number)} <span class="text-muted">/</span> {data.title}
    </h1>
    <div class="border-t border-rule"></div>
  </header>

  <!-- TIMELINE OF EVIDENCE -->
  <section aria-labelledby="timeline-heading">
    <h2 id="timeline-heading" class="label">( Timeline of evidence )</h2>
    <ol class="mt-8 space-y-12 border-l border-rule pl-6 sm:pl-10">
      {
        items.map((item) => (
          <li data-reveal class="grid gap-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
            <time datetime={item.date.toISOString().slice(0, 10)} class="label">
              {formatDate(item.date)}
            </time>
            <div class="space-y-3">
              {item.image && (
                <a href={item.image.src} data-lightbox class="block max-w-2xl">
                  <img src={item.image.src} alt={item.image.alt} loading="lazy" class="w-full" />
                </a>
              )}
              {item.video && <div class="max-w-2xl"><VideoEmbed {...item.video} /></div>}
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- FILES AND LINKS (only when there are any) -->
  {
    data.links.length > 0 && (
      <section aria-labelledby="links-heading" class="mt-12">
        <h2 id="links-heading" class="label">( Files and links )</h2>
        <ul class="mt-4 divide-y divide-border">
          {data.links.map((l) => (
            <li class="py-3 first:pt-0">
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="font-display text-2xl underline underline-offset-4 transition-colors hover:text-accent">
                {l.label} ↗<span class="sr-only"> (opens in a new tab)</span>
              </a>
              <p class="mt-1">{l.proves}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- METADATA -->
  {
    data.metadata && (
      <section aria-labelledby="meta-heading" class="mt-12">
        <h2 id="meta-heading" class="label">( Metadata )</h2>
        <div class="mt-6 overflow-x-auto" tabindex="0" role="region" aria-labelledby="meta-heading">
          <table class="w-full text-left">
            <thead class="label border-b border-rule">
              <tr>{data.metadata.columns.map((c) => <th scope="col" class="py-2 pr-6 font-normal">{c}</th>)}</tr>
            </thead>
            <tbody class="divide-y divide-border">
              {data.metadata.rows.map((row) => (
                <tr>{row.map((cell) => <td class="py-2 pr-6">{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <p class="mt-10 text-muted">All works in Part II were made by me without AI tools.</p>

  <PrevNext prev={link(prev)} next={link(next)} back={{ href: '/appendices', label: '↑ All appendices' }} />
</Layout>
