---
import Layout from '../layouts/Layout.astro';
import Loader from '../components/Loader.astro';
import Hallway3D from '../components/Hallway3D.astro';
import SkipLink from '../components/SkipLink.astro';
import Marquee from '../components/Marquee.astro';
import { site, wings } from '../data/site';
import { getAppendices, getPart1, getPart2, pad, plain } from '../lib/content';
import AccentTitle from '../components/AccentTitle.astro';
import type { Frame } from '../scripts/hallway';

const part1 = await getPart1();
const part2 = await getPart2();
const appendices = await getAppendices();

// Hallway frames: Part I highlights, then every Part II main piece (6–8 total).
const frames: (Frame & { href: string; alt: string })[] = [
  ...part1
    .filter((w) => w.data.highlight)
    .map((w) => ({ ...w.data, href: `/part-1#${w.id}`, part: 'Part I' })),
  ...part2.map((w) => ({ ...w.data, href: `/part-2/${w.id}`, part: 'Part II' })),
]
  .slice(0, 8)
  .map((w) => ({
    src: w.media[0].src,
    alt: w.media[0].alt,
    number: pad(w.number),
    title: w.title,
    part: w.part,
    date: w.date,
    medium: w.medium,
    href: w.href,
  }));

const directory = wings
  .filter((w) => w.numeral)
  .map((w) => {
    // The hover preview: a small carousel of that wing's artworks. Placeholders (alt
    // text still in parentheses) are left out until the real files are in.
    const real = (m?: { src: string; alt: string }) => m && !m.alt.startsWith('(');
    const roll = (media: ({ src: string; alt: string } | undefined)[]) =>
      media.filter(real).map((m) => m!.src).slice(0, 10);
    const info: Record<string, { count?: string; roll?: string[] }> = {
      '/part-1': { count: `${part1.length} works`, roll: roll(part1.map((w) => w.data.media[0])) },
      '/part-2': { count: `${part2.length} works`, roll: roll(part2.flatMap((w) => w.data.media)) },
      '/appendices': {
        count: `${appendices.length} folders`,
        roll: roll(appendices.flatMap((a) => a.data.items.map((item) => item.image))),
      },
    };
    return { ...w, ...info[w.href] };
  });

const artForms = part2.map((w) => w.data.type ?? w.data.title);
---

<Layout room={1}>
  <Loader />

  <Hallway3D slot="hero" frames={frames}>
    <!-- HERO: sits over the first view down the hallway -->
    <div data-hero class="absolute inset-0 flex flex-col items-center justify-center px-4 text-center">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--color-bg)_0%,color-mix(in_srgb,var(--color-bg)_70%,transparent)_45%,transparent_75%)]"
      >
      </div>
      <div class="absolute bottom-10 left-4 hidden sm:left-8 [.hallway-3d_&]:block">
        <SkipLink href="#exhibition-note" data-skip-walkthrough />
      </div>
      <h1 id="site-title" data-split class="relative max-w-6xl font-display text-[clamp(3rem,min(11vw,15svh),9rem)] leading-[0.92]">
        <AccentTitle text={site.title} />
      </h1>
      <p class="relative mt-6 font-display text-xl italic sm:text-2xl" data-reveal="fade">{site.subtitle}</p>
      <p class="label relative mt-6" data-reveal="fade">{site.tagline}</p>
      <p class="label relative mt-10" data-reveal="fade">Scroll to enter ↓</p>
    </div>
  </Hallway3D>

  <!-- Flat hallway: phones, reduced motion, or no WebGL. Hidden when the 3D runs. -->
  <section aria-labelledby="hallway-heading" class="pt-16 [.hallway-3d_&]:hidden">
    <h2 id="hallway-heading" class="label">( The hallway )</h2>
    <ol class="-mx-4 mt-6 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 pb-6 sm:-mx-8 sm:scroll-px-8 sm:px-8" tabindex="0" aria-label="Works in the hallway, scroll sideways">
      {
        frames.map((f) => (
          <li class="w-[75vw] max-w-sm shrink-0 snap-start">
            <a href={f.href} class="group block">
              <div class="aspect-[4/5] overflow-hidden border-[6px] border-ink">
                <img src={f.src} alt={f.alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <p class="label mt-3">
                ( {f.number} ) · {f.part}
              </p>
              <p class="font-display text-2xl leading-tight transition-colors group-hover:text-accent"><AccentTitle text={f.title} /></p>
              <p class="label text-muted">{[f.date, f.medium].filter(Boolean).join(' / ')}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- EXHIBITION NOTE -->
  <!-- Statement on the left, intro on the right, so the note fills the width. -->
  <section id="exhibition-note" class="scroll-mt-24 py-20 sm:py-28" aria-labelledby="note-heading">
    <p class="label" data-reveal="fade">( Exhibition note · 01 )</p>
    <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
      <h2 id="note-heading" data-split class="font-display text-3xl leading-[1.08] text-balance sm:text-5xl lg:col-span-7">
        {site.exhibitionNote.statement}
      </h2>
      <p class="text-lg lg:col-span-5 lg:border-l lg:border-border lg:pl-8" data-reveal>{site.exhibitionNote.intro}</p>
    </div>
  </section>

  <!-- FLOOR DIRECTORY -->
  <section aria-labelledby="directory-heading" class="pb-16">
    <h2 id="directory-heading" class="label" data-reveal="fade">( Floor directory )</h2>
    <ol class="mt-6 border-b border-rule">
      {
        directory.map((w) => (
          <li class="border-t border-rule" data-reveal>
            <a href={w.href} class="dir-row relative block py-5 transition-colors duration-500 hover:text-accent sm:py-6">
              {/* numeral · title · a small framed preview (wide screens, on hover) · count.
                  The preview sits in the row itself, so it never crosses the lines. */}
              <span class="flex items-center gap-x-4 sm:gap-x-6">
                <span class="dir-inner flex min-w-0 flex-1 items-baseline gap-x-4 sm:gap-x-6">
                  <span class="label w-14 shrink-0 whitespace-nowrap sm:w-16">( {w.numeral} )</span>
                  <span class="flex-1 font-display text-[1.65rem] leading-tight sm:text-4xl lg:text-5xl">{plain(w.title)}</span>
                </span>
                {w.roll && w.roll.length > 0 && (
                  <span aria-hidden="true" class="dir-thumb gilt hidden h-20 w-16 shrink-0 [--gilt-pad:0.3rem] lg:block">
                    <span class="gilt-mat h-full p-1!">
                      <span class="block h-full overflow-hidden">
                        {/* The last slide repeats the first so the loop slides on instead of rewinding. */}
                        <span data-carousel-track class="flex h-full">
                          {[...w.roll, w.roll[0]].map((src) => (
                            <img src={src} alt="" loading="lazy" class="h-full w-full shrink-0 bg-transparent object-cover" />
                          ))}
                        </span>
                      </span>
                    </span>
                  </span>
                )}
                {w.count && <span class="label shrink-0 text-right sm:w-20">{w.count}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <Marquee words={artForms} label="Art forms tried" />

</Layout>

<script>
  // Floor directory: while a row is hovered (or focused), its preview carousel
  // slides to the next artwork every second. Still with reduced motion.
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.dir-row').forEach((row) => {
    const track = row.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = track ? track.children.length - 1 : 0; // minus the repeated first slide
    if (!track || slides < 2) return;

    let index = 0;
    let timer: number | undefined;
    const slideTo = (i: number, animate = true) => {
      index = i;
      track.style.transition = animate ? 'transform 0.7s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
      track.style.transform = `translateX(-${index * 100}%)`;
    };
    // After sliding onto the repeated first slide, jump back to the real one unseen.
    track.addEventListener('transitionend', () => {
      if (index === slides) slideTo(0, false);
    });

    const start = () => {
      if (still.matches || timer) return;
      timer = window.setInterval(() => slideTo(index + 1), 1000);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    row.addEventListener('mouseenter', start);
    row.addEventListener('focus', start);
    row.addEventListener('mouseleave', stop);
    row.addEventListener('blur', stop);
  });
</script>
