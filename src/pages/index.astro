---
import Layout from '../layouts/Layout.astro';
import SkipLink from '../components/SkipLink.astro';
import Marquee from '../components/Marquee.astro';
import { site, wings } from '../data/site';
import { getPart1, getPart2 } from '../lib/content';

const part1 = await getPart1();
const part2 = await getPart2();

const counts: Record<string, string> = {
  '/part-1': `${part1.length} works`,
  '/part-2': `${part2.length} works`,
};
const directory = wings.filter((w) => w.numeral);
const artForms = part2.map((w) => w.data.type ?? w.data.title);
---

<Layout room={1}>
  {/*
    ==================================================================
    STAGE 1 · LOADER (later)
    Off-white screen, title in small caps, spinning compass needle,
    "Loading exhibition 0% → 100%". Preloads the hallway textures.
    ==================================================================
  */}

  <!-- STAGE 2 · HERO -->
  <section class="relative flex min-h-svh flex-col items-center justify-center text-center" aria-labelledby="site-title">
    {/* TODO: full-screen photo or render of the empty hallway goes behind this. */}
    <div class="absolute top-24 left-0">
      <SkipLink href="#exhibition-note" />
    </div>
    <h1 id="site-title" class="font-display text-6xl leading-[0.95] sm:text-8xl lg:text-9xl">{site.title}</h1>
    <p class="mt-6 font-display text-xl italic sm:text-2xl">{site.subtitle}</p>
    <p class="label mt-6">{site.tagline}</p>
    <p class="label absolute bottom-10">Scroll to enter ↓</p>
  </section>

  {/*
    ==================================================================
    STAGE 3 · 3D HALLWAY (later)
    Pinned, scroll-driven Three.js corridor (Hallway3D component).
    Mobile / reduced-motion fallback: horizontal swipe row of the same
    frames with museum labels.
    ==================================================================
  */}
  <div id="hallway" aria-hidden="true"></div>

  <!-- STAGE 4 · EXHIBITION NOTE -->
  <section id="exhibition-note" class="scroll-mt-24 py-32 sm:py-48" aria-labelledby="note-heading">
    <p class="label">( Exhibition note · 01 )</p>
    <h2 id="note-heading" class="mt-8 max-w-5xl font-display text-4xl leading-tight sm:text-6xl">
      {site.exhibitionNote.statement}
    </h2>
    <p class="mt-10 max-w-2xl">{site.exhibitionNote.intro}</p>
  </section>

  <!-- STAGE 5 · FLOOR DIRECTORY -->
  <section aria-labelledby="directory-heading" class="pb-16">
    <h2 id="directory-heading" class="label">( Floor directory )</h2>
    {/* TODO (motion step): on hover the row slides right and a small thumbnail appears. */}
    <ol class="mt-8 border-b border-ink">
      {
        directory.map((w) => (
          <li class="border-t border-ink">
            <a href={w.href} class="flex flex-wrap items-baseline gap-x-6 gap-y-2 py-6 hover:text-accent sm:py-8">
              <span class="label w-16 shrink-0">( {w.numeral} )</span>
              <span class="flex-1 font-display text-3xl leading-tight sm:text-5xl">{w.title}</span>
              {counts[w.href] && <span class="label">{counts[w.href]}</span>}
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <Marquee words={artForms} label="Art forms tried" />

  <!-- STAGE 6 · FOOTER / COLOPHON -->
  <footer slot="after" class="mx-auto max-w-7xl border-t border-ink px-4 py-12 sm:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:justify-between">
      <div>
        <p class="font-display text-2xl">{site.footer.name}</p>
        <p class="label mt-2">{site.footer.course} · {site.footer.section} · {site.footer.year}</p>
        <p class="mt-4 max-w-xl text-muted">{site.footer.credits}</p>
      </div>
      <a href="#site-title" class="label self-start underline-offset-4 hover:underline">Back to top ↑</a>
    </div>
  </footer>
</Layout>
