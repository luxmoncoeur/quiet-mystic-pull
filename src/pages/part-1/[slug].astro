---
// Part I works no longer have their own pages: everything (photo, poem, label,
// caption, videos) is shown in the wing itself. Old links like
// /part-1/painting land on that work's spot instead: /part-1#painting.
import { getPart1 } from '../../lib/content';

export async function getStaticPaths() {
  const works = await getPart1();
  return works.map((work) => ({ params: { slug: work.id } }));
}

return Astro.redirect(`/part-1#${Astro.params.slug}`);
---
