---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SkipLink from '../../components/SkipLink.astro';
import { wings } from '../../data/site';
import { getPart2, pad } from '../../lib/content';
import AccentTitle from '../../components/AccentTitle.astro';
import NextRoom from '../../components/NextRoom.astro';
import { getEntry } from 'astro:content';

const works = await getPart2();
const wing = wings[2];
const total = pad(works.length);
const reflection = await getEntry('reflection', 'reflection');
---

<Layout title={`Part ${wing.numeral}: ${wing.title}`} room={3}>
  <SectionHeader
    numeral={wing.numeral}
    title={wing.title}
    line={`${works.length} works, made for this portfolio, mostly in forms new to me.`}
    aside={['Beyond the classroom', works.map((w) => w.data.type ?? w.data.title).join(' · ')]}
  >
    <div class="mt-8"><SkipLink href="#works" label="Skip animation →" /></div>
  </SectionHeader>

  {/* Stacked prints: each card pins while the next slides up over it. */}
  <ol id="works" class="scroll-mt-24">
    {
      works.map((work) => {
        const [hero] = work.data.media;
        return (
          <li data-stack-card class="motion-safe:sticky motion-safe:top-0 motion-safe:h-svh py-4 sm:py-6">
            <a
              href={`/part-2/${work.id}`}
              class="group flex h-full origin-top flex-col gap-5 border border-border bg-surface p-5 shadow-[0_-18px_40px_-20px_var(--shadow)] sm:p-8"
            >
              <div class="flex flex-wrap items-start justify-between gap-4">
                <p class="font-display text-5xl leading-none sm:text-7xl">
                  <span class="text-accent">{pad(work.data.number)}</span> <span class="text-muted">/ {total}</span>
                </p>
                <span class="tag">{work.data.familiar ? 'Familiar practice' : 'New to me'}</span>
              </div>
              <div>
                <h2 class="font-display text-3xl leading-tight transition-colors group-hover:text-accent sm:text-5xl"><AccentTitle text={work.data.title} /></h2>
                {work.data.type && <p class="label mt-2">{work.data.type}</p>}
              </div>
              <div class="min-h-[40svh] flex-1 overflow-hidden">
                <img
                  src={hero.src}
                  alt={hero.alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-1000 ease-out motion-safe:group-hover:scale-[1.03]"
                />
              </div>
              <p class="label transition-colors group-hover:text-accent">Open the feature →</p>
            </a>
          </li>
        );
      })
    }
  </ol>

  {/* The next room: the reflection, with its cover photo in a small gilded frame. */}
  {
    reflection?.data.cover && (
      <NextRoom href="/reflection" title={wings[3].title} note="A letter · 4 min read" items={[reflection.data.title ?? 'A letter', 'Then: a blank canvas', 'Now: the pull of the sea', 'Next: still building up']} image={reflection.data.cover} />
    )
  }
</Layout>
