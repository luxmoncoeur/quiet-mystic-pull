---
// ( I ) counter + huge title + one line. Used at the top of each wing.
import AccentTitle from './AccentTitle.astro';

interface Props {
  numeral: string;
  title: string;
  line?: string;
}

const { numeral, title, line } = Astro.props;
---

<header class="pt-36 pb-16 sm:pt-44">
  <p class="label" data-reveal="fade">( {numeral} )</p>
  <h1 data-split class="mt-6 display-xl font-display"><AccentTitle text={title} /></h1>
  {line && <p class="mt-8 max-w-2xl" data-reveal>{line}</p>}
  <slot />
</header>
