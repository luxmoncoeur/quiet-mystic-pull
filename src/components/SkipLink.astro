---
// "Skip the walkthrough →" / "Skip animation →": jumps past the motion to the content.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  label?: string;
}

const { href, label = 'Skip the walkthrough →', ...rest } = Astro.props;
---

<a href={href} class="label inline-block underline-offset-4 transition-colors hover:text-accent hover:underline" {...rest}>{label}</a>
