---
// Top nav. Hides on scroll down and returns on scroll up (scripts/motion.ts).
import { site, wings } from '../data/site';
import { plain } from '../lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = wings.filter((w) => w.nav);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header data-nav class="fixed inset-x-0 top-0 z-40 bg-bg/90 backdrop-blur-sm">
  <nav aria-label="Main" class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-8">
    <a href="/" class="font-display text-xl leading-tight transition-colors hover:text-accent">{plain(site.title)}</a>

    <div class="flex items-center gap-6">
    <ul class="label hidden items-center gap-6 md:flex">
      {
        links.map((w) => (
          <li>
            <a
              href={w.href}
              aria-current={isCurrent(w.href) ? 'page' : undefined}
              class:list={[
                'underline-offset-4 transition-colors hover:text-accent hover:underline',
                isCurrent(w.href) && 'text-accent underline',
              ]}
            >
              {w.nav}
              {w.nav !== w.title && <span class="sr-only">: {plain(w.title)}</span>}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      data-theme-toggle
      class="label hidden text-muted transition-colors hover:text-accent [.js_&]:inline-block"
      aria-label="Switch color theme"
    >
      <span data-theme-word="light">light</span> / <span data-theme-word="dark">dark</span>
    </button>

    <button
      type="button"
      class="label md:hidden"
      aria-expanded="false"
      aria-controls="menu-panel"
      data-menu-toggle
    >
      Menu
    </button>
    </div>
  </nav>

  <div id="menu-panel" hidden class="fixed inset-0 z-50 flex flex-col bg-bg px-4 py-4 md:hidden">
    <div class="flex justify-end">
      <button type="button" class="label" data-menu-toggle>Close</button>
    </div>
    <ul class="mt-12 space-y-6">
      {
        wings.map((w) => (
          <li>
            <a
              href={w.href}
              aria-current={isCurrent(w.href) && (w.href !== '/' || path === '/') ? 'page' : undefined}
              class="block font-display text-4xl transition-colors hover:text-accent"
            >
              {w.numeral && <span class="label mr-3 align-middle">( {w.numeral} )</span>}
              {plain(w.title)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Light / dark toggle. The theme itself is set before paint in Layout's <head>;
  // this flips it, remembers the choice, and tells the 3D hallway to repaint.
  const html = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const currentTheme = () => html.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

  const syncTheme = () => {
    html.dataset.mode = currentTheme();
    themeToggle.setAttribute('aria-label', `Switch to ${html.dataset.mode === 'dark' ? 'light' : 'dark'} mode`);
    window.dispatchEvent(new Event('themechange'));
  };

  themeToggle.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage blocked (private mode): the choice lasts for this page only.
    }
    syncTheme();
  });
  systemDark.addEventListener('change', syncTheme);
  syncTheme();

  const panel = document.getElementById('menu-panel')!;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]');
  const openButton = toggles[0];

  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    openButton.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) document.body.dataset.menuOpen = 'true';
    else delete document.body.dataset.menuOpen;
    (open ? toggles[1] : openButton).focus();
  };

  toggles.forEach((t) => t.addEventListener('click', () => setOpen(panel.hidden)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) setOpen(false);
  });
</script>
