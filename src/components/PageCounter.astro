---
// Small ( 02 / 05 ) in the corner showing which room of the museum you're in.
import { wings } from '../data/site';
import { pad, plain } from '../lib/content';

interface Props {
  room: number; // 1-based position in `wings`
}

const { room } = Astro.props;
---

<p class="label pointer-events-none fixed right-4 bottom-4 z-30 bg-bg/85 px-2 py-0.5 sm:right-8 sm:bottom-6">
  <span class="sr-only">Room {room} of {wings.length}:</span>
  <span aria-hidden="true">( {pad(room)} / {pad(wings.length)} )</span>
  <span class="sr-only">{plain(wings[room - 1].title)}</span>
</p>
