---
// Previous / next in exhibition order, plus an optional "back" link.
import { plain } from '../lib/content';

interface Link {
  href: string;
  label: string;
}

interface Props {
  prev?: Link;
  next?: Link;
  back?: Link;
}

const { prev, next, back } = Astro.props;
---

<nav aria-label="More works" class="mt-16 border-t border-rule pt-6">
  <div class="grid gap-6 sm:grid-cols-3">
    <div>
      {
        prev && (
          <a href={prev.href} class="group block">
            <span class="label text-muted">← Previous</span>
            <span class="mt-1 block font-display text-xl leading-tight transition-colors group-hover:text-accent sm:text-2xl">{plain(prev.label)}</span>
          </a>
        )
      }
    </div>
    <div class="sm:text-center">
      {back && <a href={back.href} class="label underline-offset-4 transition-colors hover:text-accent hover:underline">{back.label}</a>}
    </div>
    <div class="sm:text-right">
      {
        next && (
          <a href={next.href} class="group block">
            <span class="label text-muted">Next →</span>
            <span class="mt-1 block font-display text-xl leading-tight transition-colors group-hover:text-accent sm:text-2xl">{plain(next.label)}</span>
          </a>
        )
      }
    </div>
  </div>
</nav>
