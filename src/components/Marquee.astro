---
// Slow row of repeated words. Drifts constantly and speeds up a little while
// scrolling (see scripts/motion.ts); sits still with reduced motion.
interface Props {
  words: string[];
  label?: string;
}

const { words, label = 'Art forms' } = Astro.props;
const line = words.join(' · ');
---

<div class="overflow-hidden border-y border-rule py-3" data-marquee>
  <p class="sr-only">{label}: {words.join(', ')}</p>
  <div
    aria-hidden="true"
    data-marquee-track
    class="flex w-max gap-8 font-display text-2xl whitespace-nowrap italic will-change-transform sm:text-4xl"
  >
    {[0, 1, 2, 3, 4, 5].map(() => <span>{line} ·</span>)}
  </div>
</div>
